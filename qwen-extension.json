{
  "name": "atlas-core",
  "version": "0.1.0-beta.4",
  "description": "Shared Revit sessions, work identity, inspection, review, recovery and verified delivery.",
  "mcpServers": {
    "atlas_core": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
