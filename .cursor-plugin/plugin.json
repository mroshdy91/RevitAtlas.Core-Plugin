{
  "name": "atlas-core",
  "version": "0.1.0-beta.4",
  "description": "Shared Revit sessions, work identity, inspection, review, recovery and verified delivery.",
  "author": {
    "name": "ROSHDY"
  },
  "homepage": "https://github.com/mroshdy91/RevitAtlas.Core-Plugin",
  "repository": "https://github.com/mroshdy91/RevitAtlas.Core-Plugin",
  "license": "LicenseRef-Atlas-Free-Use",
  "keywords": [
    "revit",
    "bim",
    "core"
  ],
  "mcpServers": {
    "atlas_core": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "${CURSOR_PLUGIN_ROOT}/scripts/atlas-mcp.ps1",
        "-Surface",
        "core"
      ]
    }
  }
}
